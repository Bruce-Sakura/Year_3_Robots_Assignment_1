          <specular>0.9 0.9 0.9 1</specular>
        </material>
      </visual>
      <collision name="steel_ball">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.005</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.05</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="front_ball_joint" type="ball">
      <parent>base_link</parent>
      <child>front_ball</child>
      <pose relative_to="front_ball">0 0 0 0 0 0</pose>
    </joint>
    <joint name="rear_ball_joint" type="ball">
      <parent>base_link</parent>
      <child>rear_ball</child>
      <pose relative_to="rear_ball">0 0 0 0 0 0</pose>
    </joint>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <pose relative_to="left_wheel">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>0.2</effort>
          <velocity>40</velocity>
        </limit>
      </axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <pose relative_to="right_wheel">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>0.2</effort>
          <velocity>40</velocity>
        </limit>
      </axis>
    </joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.10</wheel_separation>
      <wheel_radius>0.025</wheel_radius>
      <topic>/model/round_robot/cmd_vel</topic>
      <odom_topic>/model/round_robot/odometry</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <!-- Differential Drive Controller -->
<plugin
    filename="gz-sim-diff-drive-system"
    name="gz::sim::systems::DiffDrive">

    <left_joint>left_wheel_joint</left_joint>
    <right_joint>right_wheel_joint</right_joint>

    <wheel_separation>0.10</wheel_separation>
    <wheel_radius>0.025</wheel_radius>

    <topic>/model/round_robot/cmd_vel</topic>
    <odom_topic>/model/round_robot/odometry</odom_topic>

    <frame_id>odom</frame_id>
    <child_frame_id>base_link</child_frame_id>
    <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- Wheel Joint State Publisher: NEW -->
    <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">

        <topic>/model/round_robot/joint_states</topic>

        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>

        <update_rate>50</update_rate>
    </plugin>
  </model>
</sdf>